# Optional: live resale prices per game from SeatGeek (free key at https://platform.seatgeek.com).
# Without it you type in the resale value yourself after checking the links in the app.
VITE_SEATGEEK_CLIENT_ID=

# Optional: real-time sync between you and your friend via Supabase.
# Without these the app still works (localStorage + share links).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
